<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 法语复数规则（CLDR：one 含 0 与 1）。占位必须全部用 %#@name@。 -->
<plist version="1.0">
<dict>
	<key>count.itemsFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
	<key>count.itemsSelectedFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@total@ · %#@sel@ sélectionné(s)</string>
		<key>total</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
		<key>sel</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>delete.itemsFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
	<key>delete.foldersFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string> (dont %#@n@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dossier et son contenu</string>
			<key>other</key>
			<string>%lld dossiers et leur contenu</string>
		</dict>
	</dict>
	<key>transfer.runningCountFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Transfert… %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément</string>
			<key>other</key>
			<string>%lld éléments</string>
		</dict>
	</dict>
</dict>
</plist>