<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 德语复数规则（one / other）。占位必须全部用 %#@name@，不可与普通 %@ 混用。 -->
<plist version="1.0">
<dict>
	<key>count.itemsFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
	<key>count.itemsSelectedFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@total@ · %#@sel@ ausgewählt</string>
		<key>total</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
		<key>sel</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>delete.itemsFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
	<key>delete.foldersFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string> (einschl. %#@n@)</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Ordner mit Inhalt</string>
			<key>other</key>
			<string>%lld Ordner mit Inhalt</string>
		</dict>
	</dict>
	<key>transfer.runningCountFormat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Übertragung … %#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt</string>
			<key>other</key>
			<string>%lld Objekte</string>
		</dict>
	</dict>
</dict>
</plist>